# =============================================================================
# ForgeOS — root env template (copy to app/.env.local)
# Primary testnet: Ethereum Sepolia (chain 11155111) — required for ERC-7715 Flask.
# Venice x402: Base mainnet (chain 8453).
# =============================================================================

# Local dev — production: https://forgeagent.vercel.app
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── Ethereum Sepolia (wallet, contracts, ERC-7715, 1Shot) ───────────────────
NEXT_PUBLIC_CHAIN_ID=11155111
NEXT_PUBLIC_SEPOLIA_RPC_URL=https://rpc.ankr.com/eth_sepolia
ONESHOT_CHAIN_ID=11155111

# USDC on Ethereum Sepolia (Circle test token — faucet at faucet.circle.com)
NEXT_PUBLIC_USDC_ADDRESS=0x1c7D4B196Cb0C7B01d743Fbc6116a902379C7238

# Deployed on Ethereum Sepolia (block 10944968 — see contracts/broadcast/Deploy.s.sol/11155111/)
NEXT_PUBLIC_REGISTRY_ADDRESS=0xDE52F54c88510F9eC584f514CEAB4b965bbf2A68
NEXT_PUBLIC_OS_KERNEL_ADDRESS=0xa4bD3e0946431dFA0C38F700f5935E03b749C77C
NEXT_PUBLIC_AGENT_TREASURY_ADDRESS=0x95B93bF1Ed959dfb1BBEC6Af023A3263740BC429
REGISTRY_DEPLOY_BLOCK=10945007
OS_KERNEL_ADDRESS=0xa4bD3e0946431dFA0C38F700f5935E03b749C77C
REGISTRY_ADDRESS=0xDE52F54c88510F9eC584f514CEAB4b965bbf2A68
AGENT_TREASURY_ADDRESS=0x95B93bF1Ed959dfb1BBEC6Af023A3263740BC429

# ─── Venice x402 — agent wallet (Base mainnet, chain 8453) ───────────────────
#
# OPTION A — Turnkey HSM (recommended for production)
# The secp256k1 Ethereum private key never leaves Turnkey's hardware.
# What goes here is an Ed25519 API keypair — rotatable without changing the wallet.
# Setup: https://docs.turnkey.com/getting-started/quickstart
#   1. Create org + wallet at app.turnkey.com
#   2. Create an API key under your user — copy public + private (shown once)
#   3. Set TURNKEY_WALLET_ADDRESS to the Ethereum address Turnkey generated
#
TURNKEY_API_PUBLIC_KEY=
TURNKEY_API_PRIVATE_KEY=
TURNKEY_ORGANIZATION_ID=
TURNKEY_PRIVATE_KEY_ID=
TURNKEY_WALLET_ADDRESS=
#
# OPTION B — raw private key (dev / testing only — never use in production)
# Fund this wallet with USDC on Base mainnet before use.
AGENT_WALLET_KEY=
#
VENICE_CHAIN_ID=8453
NEXT_PUBLIC_BASE_RPC_URL=https://mainnet.base.org
NEXT_PUBLIC_USDC_BASE_ADDRESS=0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913

# ─── 1Shot ───────────────────────────────────────────────────────────────────
# Public relayer: Sepolia / Base Sepolia use .dev; mainnet uses .com
ONESHOT_RELAYER_URL=https://relayer.1shotapi.dev/relayers
ONESHOT_API_KEY=
ONESHOT_WEBHOOK_SECRET=
# ONESHOT_WEBHOOK_URL=

# ─── A2A agents (golden-path step 5: 2-hop delegation chain) ─────────────────
# Hop-1 delegate (DeFi agent). Missing → sub-delegation chain is never created
# and the A2A execution path breaks silently in useSubDelegations.
NEXT_PUBLIC_DEFI_AGENT_ADDRESS=
# Hop-2 delegate (Payment agent). Missing → same failure as above.
NEXT_PUBLIC_PAYMENT_AGENT_ADDRESS=

# ─── Kill switch + agent runtime (server-side secrets — never NEXT_PUBLIC) ───
# Private key of the OSKernel owner wallet. Missing → /api/relay/revoke-all and
# /api/relay/revoke return 503 and golden-path step 6 (kill switch) fails.
FORGE_OWNER_KEY=
# Bearer secret for cron-triggered endpoints. Missing → /api/cron/agent-runner
# rejects all calls and /api/delegations/bundle returns 401 (agents never fire).
CRON_SECRET=
# Smart account whose delegation bundle the cron agent runner executes against.
# Missing → /api/cron/agent-runner and /api/agents/run cannot look up the
# delegation bundle, so scheduled agents do not run.
FORGE_SMART_ACCOUNT_ADDRESS=

# ─── Indexing ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUBGRAPH_URL=

# ─── Foundry / server RPC (optional if not in contracts/.env) ────────────────
ETHERSCAN_API_KEY=

# ─── Foundry deploy only (contracts/.env) ────────────────────────────────────
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_KEY
USDC_ADDRESS=0x1c7D4B196Cb0C7B01d743Fbc6116a902379C7238
PLATFORM_FEE_RECIPIENT=0x9aC2d5a0A0E88D459Ecfb68Bcbb94DFD7cdF1f09
